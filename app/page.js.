'use client';
import { useState } from 'react';

export default function NameLab() {
  const [keyword, setKeyword] = useState('');
  const [results, setResults] = useState([]);

  const generate = () => {
    if (!keyword) return;
    const suffixes = ['ify', 'lab', 'hub', 'core', 'tech', 'flow', 'io', 'prime'];
    const newResults = suffixes.map(s => `${keyword.toLowerCase()}${s}`);
    setResults(newResults);
  };

  return (
    <div style={{ 
      backgroundColor: '#0a0a0a', 
      color: 'white', 
      minHeight: '100vh', 
      padding: '40px 20px',
      display: 'flex',
      flexDirection: 'column',
      alignItems: 'center',
      fontFamily: 'sans-serif'
    }}>
      <h1 style={{ color: '#a78bfa', marginBottom: '20px' }}>NameLab</h1>
      
      <div style={{ display: 'flex', gap: '10px', marginBottom: '30px' }}>
        <input 
          value={keyword} 
          onChange={(e) => setKeyword(e.target.value)} 
          placeholder="Ketik kata kunci..." 
          style={{ 
            padding: '10px 15px', 
            borderRadius: '8px', 
            border: '1px solid #333', 
            backgroundColor: '#1f2937',
            color: 'white'
          }}
        />
        <button 
          onClick={generate}
          style={{ 
            padding: '10px 20px', 
            borderRadius: '8px', 
            backgroundColor: '#a78bfa', 
            border: 'none', 
            color: 'white',
            fontWeight: 'bold',
            cursor: 'pointer'
          }}
        >
          Generate
        </button>
      </div>

      <div style={{ display: 'flex', flexWrap: 'wrap', gap: '10px', justifyContent: 'center', maxWidth: '600px' }}>
        {results.map((name, i) => (
          <span key={i} style={{ 
            backgroundColor: '#1f2937', 
            padding: '8px 16px', 
            borderRadius: '20px',
            fontSize: '14px'
          }}>
            {name}
          </span>
        ))}
      </div>
    </div>
  );
}
